---
import { formatDate, threadSlug, memberSlug, routePath } from '../lib/format.ts';
import type { MemberData } from '../lib/types.ts';
import ThreadFlags from './ThreadFlags.astro';

interface Props {
	id: string;
	title: string;
	startedBy: string;
	createdDate: string;
	responses: number;
	views: number;
	sticky: boolean;
	closed: boolean;
	member?: MemberData;
}

const { id, title, startedBy, createdDate, responses, views, sticky, closed, member } = Astro.props;

// Below `sm` the row stacks: the title gets its own line, the remaining cells run
// inline as a muted meta line separated by middots
const meta = 'inline text-sm text-(--color-text-muted) sm:table-cell sm:px-2 sm:py-2 sm:text-base';
const separated = "before:px-1.5 before:content-['·'] sm:before:content-none";
const unmuted = 'sm:text-(--color-text)';
---

<tr id={id ? `thread-${id}` : undefined} class:list={[
	'block border-b border-(--color-border) px-2 py-3 sm:table-row sm:p-0',
	{ 'bg-(--color-badge-sticky-bg)/10': sticky },
]}>
	<td class="block sm:table-cell sm:px-2 sm:py-2">
		<ThreadFlags sticky={sticky} closed={closed} />
		{id ? (
			<a href={routePath(`/thread/${threadSlug(id, title)}`)} class="thread-trigger text-(--color-link) hover:underline" data-thread-id={id}>{title}</a>
		) : (
			title
		)}
	</td>
	<td class={`${meta} ${unmuted}`}>
		{member
			? <a href={routePath(`/member/${memberSlug(member.id, member.name)}`)} class="member-trigger text-inherit no-underline hover:underline" data-member-name={startedBy}>{startedBy}</a>
			: <span>{startedBy}</span>
		}
	</td>
	<td class={`${meta} ${separated} whitespace-nowrap`}><time datetime={createdDate} title={createdDate}>{formatDate(createdDate)}</time></td>
	<td class={`${meta} ${separated} ${unmuted} tabular-nums sm:text-right`}>{responses}<span class="sm:hidden"> replies</span></td>
	<td class={`${meta} ${separated} ${unmuted} tabular-nums sm:text-right`}>{views.toLocaleString()}<span class="sm:hidden"> views</span></td>
</tr>
