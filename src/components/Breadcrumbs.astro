---
import { getRootForum, type Breadcrumb } from '../lib/data.ts';
import { routePath } from '../lib/format.ts';

interface Props {
	trail: Breadcrumb[];
}

const { trail } = Astro.props;

const root = await getRootForum();
const items: Breadcrumb[] = root && trail.length > 0
	? [{ label: root.name, href: routePath('/') }, ...trail]
	: [];
---

{items.length > 0 && (
	<nav aria-label="Breadcrumb" class="sticky top-0 z-40 -mx-4 border-b border-(--color-border) bg-(--color-surface)/95 px-4 py-2 text-sm backdrop-blur-sm">
		<ol class="flex flex-wrap items-center gap-1">
			{items.map((item, i) => (
				<li class="flex items-center gap-1">
					{i > 0 && <span class="text-(--color-text-muted)" aria-hidden="true">/</span>}
					{i < items.length - 1 ? (
						<a href={item.href} class="text-(--color-link) hover:underline">{item.label}</a>
					) : (
						<span class="text-(--color-text-muted) truncate max-w-xs" aria-current="page">{item.label}</span>
					)}
				</li>
			))}
		</ol>
	</nav>
)}
