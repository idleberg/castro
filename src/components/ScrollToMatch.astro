---
interface Props {
	selector: string;
}

const { selector } = Astro.props;
---

<script is:inline define:vars={{ selector }}>
	(function() {
		var query = new URLSearchParams(location.search).get('q');
		if (!query) return;
		var q = query.toLowerCase();
		var els = document.querySelectorAll(selector);
		for (var i = 0; i < els.length; i++) {
			if (els[i].textContent.toLowerCase().includes(q)) {
				var match = els[i];
				match.classList.add('is-match');
				match.scrollIntoView({ behavior: 'smooth', block: 'center' });
				history.replaceState(null, '', location.pathname + '#' + match.id);
				// Hand the highlight over to :target once another permalink is clicked
				window.addEventListener('hashchange', function() {
					match.classList.remove('is-match');
				}, { once: true });
				break;
			}
		}
	})();
</script>
