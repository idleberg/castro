---
import type { Post } from '../lib/types.ts';
import { formatDateTime, memberSlug, routePath } from '../lib/format.ts';
import { sanitizeHtml } from '../lib/sanitize.ts';
import { avatar } from '../lib/avatar.ts';

interface Props {
	post: Post;
}

const { post } = Astro.props;
---

<article id={`post-${post.id}`} class="rounded-lg bg-(--color-surface-alt) p-4">
	<header class="mb-3 flex flex-wrap items-center gap-3 border-b border-(--color-border) pb-2">
		<a
			href={routePath(`/member/${memberSlug(post.authorId, post.author)}`)}
			class="member-trigger flex items-center gap-2 font-semibold text-inherit no-underline hover:underline"
			data-member-id={post.authorId}
		>
			<span class="inline-block size-6 rounded-full overflow-hidden ring-1 ring-(--color-border)" aria-hidden="true" set:html={avatar(post.author)} />
			{post.author}
		</a>
		<time datetime={post.created} title={post.created} class="text-sm text-(--color-text-muted)">{formatDateTime(post.created)}</time>
		{post.updated && (
			<span class="text-sm italic text-(--color-text-muted)">edited <time datetime={post.updated} title={post.updated}>{formatDateTime(post.updated)}</time></span>
		)}
		<a href={`#post-${post.id}`} class="ml-auto text-sm text-(--color-text-muted) hover:text-(--color-link) no-underline" aria-label={`Link to post ${post.id}`}>#</a>
	</header>

	{post.title && <h2 class="mb-2 text-lg font-semibold">{post.title}</h2>}

	<div class="post-body text-base leading-relaxed break-words" set:html={sanitizeHtml(post.body)} />

	{post.attachments.length > 0 && (
		<footer class="post-footer">
			<h3 class="mb-1 text-sm font-semibold text-(--color-text-muted)">Attachments</h3>
			<ul class="space-y-0.5">
				{post.attachments.map((att) => (
					<li class="text-sm">
						<a href={att.url?.startsWith('/') ? routePath(att.url) : att.url ?? routePath(`/attachments/${att.id}`)} {...((att.url ?? '/').startsWith('/') ? { download: att.name } : { target: '_blank', rel: 'noopener' })} class="text-(--color-link) hover:underline">{att.name}</a>
						{(att.size || att.views > 0) && (
							<span class="text-(--color-text-muted) ml-1">({[att.size, att.views > 0 && `${att.views.toLocaleString()} ${att.views === 1 ? 'download' : 'downloads'}`].filter(Boolean).join(', ')})</span>
						)}
					</li>
				))}
			</ul>
		</footer>
	)}
</article>

<style>
	.post-body :global(blockquote) {
		border-left: 3px solid var(--color-border);
		padding: 0.5rem 0.75rem;
		margin: 0.5rem 0;
		color: var(--color-text-muted);
		background: var(--color-code-bg);
		border-radius: 0 0.25rem 0.25rem 0;
	}

	.post-body :global(pre) {
		background: var(--color-code-bg);
		padding: 0.75rem;
		border-radius: 0.25rem;
		overflow-x: auto;
		font-size: 0.875rem;
		margin: 0.5rem 0;
	}

	.post-body :global(a) {
		color: var(--color-link);
		text-decoration: underline;
	}

	.post-body :global(img) {
		max-width: 100%;
		height: auto;
	}

	.post-footer {
		margin-top: 0.75rem;
		border-top: 1px solid var(--color-border);
		padding-top: 0.5rem;
		background: var(--color-code-bg);
		margin-inline: -1rem;
		margin-bottom: -1rem;
		padding: 0.75rem 1rem;
		border-radius: 0 0 0.5rem 0.5rem;
	}
</style>
