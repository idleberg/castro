---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ForumListing from '../../components/ForumListing.astro';
import ScrollToMatch from '../../components/ScrollToMatch.astro';
import { getForum, getSubForums } from '../../lib/data.ts';
import { SITE_NAME } from 'astro:env/server';
import { FORUM_PER_PAGE } from '../../lib/constants.ts';
import { routePath } from '../../lib/format.ts';

export async function getStaticPaths() {
	// The root forum lives at `/`, so only subforums are routed here
	const forums = await getSubForums();
	return forums.flatMap((f) => {
		const totalPages = Math.max(1, Math.ceil(f.threads.length / FORUM_PER_PAGE));
		return Array.from({ length: totalPages }, (_, i) => ({
			params: { slug: i === 0 ? String(f.channelId) : `${f.channelId}/page/${i + 1}` },
			props: { channelId: f.channelId, page: i + 1, totalPages },
		}));
	});
}

const { channelId, page, totalPages } = Astro.props;
const forum = await getForum(channelId);
if (!forum) return Astro.redirect(routePath('/'));
---

<Layout title={`${forum.name} — ${SITE_NAME}`} indexable={false}>
	<Breadcrumbs trail={[{ label: forum.name }]} />

	<ForumListing
		forum={forum}
		page={page}
		totalPages={totalPages}
		baseUrl={routePath(`/forum/${channelId}`)}
	/>
</Layout>

<ScrollToMatch selector='tr[id^="thread-"]' />
