---
import Layout from '../layouts/Layout.astro';
import ForumListing from '../components/ForumListing.astro';
import ScrollToMatch from '../components/ScrollToMatch.astro';
import { getRootForum, getSubForums } from '../lib/data.ts';
import { FORUM_PER_PAGE } from '../lib/constants.ts';
import { routePath } from '../lib/format.ts';

const rootForum = await getRootForum();
const subForums = await getSubForums();
const totalPages = Math.max(1, Math.ceil((rootForum?.threads.length ?? 0) / FORUM_PER_PAGE));
---

<Layout indexable={false}>
	{!rootForum || (subForums.length === 0 && rootForum.threads.length === 0) ? (
		<p class="text-(--color-text-muted)">No scraped data found. Run the scraper first.</p>
	) : (
		<ForumListing
			forum={rootForum}
			page={1}
			totalPages={totalPages}
			baseUrl={routePath('')}
			subForums={subForums}
		/>
	)}
</Layout>

<ScrollToMatch selector='tr[id^="thread-"]' />
